{
  "name": "agent-memory-store",
  "version": "0.1.0",
  "description": "Shared, persistent memory for teams of AI agents over MCP. Hybrid search (SQLite FTS5 + local multilingual embeddings), safe for many agent processes, zero external services.",
  "type": "module",
  "exports": {
    ".": "./src/store/memory-store.js",
    "./embeddings": "./src/embeddings.js"
  },
  "bin": {
    "agent-memory-store": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --no-warnings --test \"test/*.test.js\"",
    "lint": "node --check src/index.js && node --check src/server.js && node --check src/embeddings.js && node --check src/migrate.js && node --check src/store/memory-store.js",
    "bench": "node --no-warnings benchmarks/bench.js",
    "bench:golden": "node --no-warnings benchmarks/golden.js",
    "bench:tune-fusion": "node --no-warnings benchmarks/tune-fusion.js",
    "bench:longmemeval": "node --no-warnings benchmarks/longmemeval.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "memory",
    "rag",
    "bm25",
    "embeddings",
    "semantic-search",
    "sqlite",
    "vector",
    "kv-store",
    "context",
    "opencode",
    "claude",
    "llm"
  ],
  "author": "Vinícius Barreto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vbfs/agent-memory-store.git"
  },
  "bugs": {
    "url": "https://github.com/vbfs/agent-memory-store/issues"
  },
  "homepage": "https://github.com/vbfs/agent-memory-store#readme",
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "skills/"
  ],
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  }
}
